{
  "name": "first-contribution-playground",
  "version": "2.0.0",
  "description": "Beginner-friendly open-source playground for first pull requests",
  "type": "module",
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "build:data": "tsx scripts/build-data.ts",
    "build:badges": "tsx scripts/badge-generator.ts",
    "community:setup": "tsx scripts/community-setup.ts",
    "dev": "cd web && npm run dev",
    "build": "npm run build:data && cd web && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.14.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AbdullahOztoprak/first-contribution-playground"
  },
  "keywords": ["open-source", "first-contribution", "beginner-friendly", "github-actions", "astro", "typescript"],
  "author": "AbdullahOztoprak",
  "license": "MIT"
}
